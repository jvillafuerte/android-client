<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- D-pad focus is the active target: give it the strongest colour. -->
    <item android:state_focused="true" android:color="@color/tab_focused" />
    <item android:state_checked="true" android:color="@color/nb_orange_text" />
    <item android:color="@color/tab_unselected" />
</selector>
