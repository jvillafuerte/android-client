<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: raised dark field with the accent border. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_gray_light" />
            <stroke
                android:width="2dp"
                android:color="@color/nb_orange_text" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Default: raised dark field with a visible border. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_gray_light" />
            <stroke
                android:width="1dp"
                android:color="@color/nb_gray_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
