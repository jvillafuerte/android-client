<?xml version="1.0" encoding="utf-8"?>
<!-- Profile card. The active profile used to differ only by the small
     "Active" pill; the card itself was identical to every other one. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_selected_bg" />
                    <stroke
                        android:width="2dp"
                        android:color="@color/nb_selected_stroke" />
                </shape>
            </item>
            <item
                android:width="8dp"
                android:gravity="start">
                <shape android:shape="rectangle">
                    <solid android:color="@color/nb_selected_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:drawable="@drawable/card_bg" />
</selector>
