<?xml version="1.0" encoding="utf-8"?>
<!-- Focus treatment for buttons: a translucent wash plus a border. Both
     colours flip with the theme, so a focused button is visible on the light
     theme too (the old white-on-white variant was not). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_focus_fill" />
            <stroke
                android:width="3dp"
                android:color="@color/nb_focus_stroke" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
