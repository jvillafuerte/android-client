<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation item states. The old drawable was a square ripple with no
     checked or focused surface, so on a TV only the label colour changed.
     Now the selected item gets a tinted pill with an accent border, and the
     focused item gets a focus-ring pill. Focus wins because it is the active
     D-pad target. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_focus_fill" />
            <stroke
                android:width="2dp"
                android:color="@color/nb_focus_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nb_selected_bg" />
            <stroke
                android:width="2dp"
                android:color="@color/nb_selected_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <item>
        <ripple android:color="?android:attr/colorControlHighlight">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </ripple>
    </item>
</selector>
