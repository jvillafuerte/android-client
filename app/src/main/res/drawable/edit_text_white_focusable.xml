<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: white field with the darker accent border, so the highlight
         stays visible on a light background. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="@color/nb_orange_text" />
            <corners android:radius="6dp" />
        </shape>
    </item>

    <!-- Default: white field with a visible hairline border. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="@color/nb_gray_border" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
