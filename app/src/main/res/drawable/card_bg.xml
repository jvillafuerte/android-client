<?xml version="1.0" encoding="utf-8"?>
<!-- Standard card/row surface: one step above the page, with a hairline
     border so adjacent cards stay distinct on both themes. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/nb_gray_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/nb_card_stroke" />
</shape>
