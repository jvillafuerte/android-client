<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="purple_200">#FFBB86FC</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="teal_700">#FF018786</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!--
      Surfaces are a three-step ladder: page (nb_bg*), card/row (nb_gray_bg) and
      raised sheet/dialog (nb_sheet_bg / nb_gray_light). Keep the steps apart:
      the old palette had the page and the rows within 1.05:1, which made every
      list look like one flat block.
    -->
    <color name="nb_sheet_bg">#FFFFFF</color>
    <color name="nb_bg">#E9EDF1</color>
    <color name="nb_bg_peers">#EDF0F4</color>
    <color name="nb_bg_home">#EDF0F4</color>
    <color name="nb_bg_mask">#E9EDF1</color>
    <color name="nb_gray_light">#F4F6F8</color>
    <color name="nb_gray_dark">#4E4E4E</color>
    <color name="nb_gray_bg">#FFFFFF</color>
    <color name="nb_gray_separator">#D6DDE4</color>
    <color name="nb_gray_border">#D6DDE4</color>
    <color name="nb_chip_border">#C3CBD4</color>
    <color name="nb_card_stroke">#D9E0E7</color>
    <color name="nb_toolbar_divider">#D6DDE4</color>

    <!-- Brand fill. Text on it uses nb_on_orange; text/icon accents use nb_orange_text. -->
    <color name="nb_orange">#F58431</color>
    <color name="nb_orange_15">#26F58431</color>
    <color name="nb_orange_text">#A84800</color>
    <color name="nb_on_orange">#1A1206</color>

    <color name="nb_txt">#23272C</color>
    <color name="nb_txt_light">#5B6570</color>
    <color name="nb_button_inactive">#6B7580</color>

    <!-- Selection. The tint is deliberately quiet; the 2dp stroke and the 4dp
         leading bar are what make it unmistakable, in both themes. -->
    <color name="nb_selected_bg">#FFE9D6</color>
    <color name="nb_selected_stroke">#C25A0A</color>

    <!-- Keyboard/D-pad focus. White on dark, ink on light: the old white ring
         disappeared completely in the light theme. -->
    <color name="nb_focus_stroke">#14181C</color>
    <color name="nb_focus_fill">#1A000000</color>

    <!-- Peer detail: latency bands and transfer direction, matching the desktop app -->
    <color name="nb_latency_good">#1F7A3A</color>
    <color name="nb_latency_high">#8A5A00</color>
    <color name="nb_transfer_rx">#1D6FA8</color>

    <!-- Chrome surfaces -->
    <color name="nb_bottom_nav_bg">#FFFFFF</color>
    <color name="nb_chip_bg">#FFFFFF</color>

    <!-- Bottom navigation unselected item colour -->
    <color name="tab_unselected">#5B6570</color>
    <color name="tab_icon_unselected">#5B6570</color>
    <!-- Focused navigation item, and the checkbox/checkmark accent. -->
    <color name="tab_focused">#14181C</color>

    <color name="thumb_on_color">#F58431</color>
    <color name="thumb_off_color">#FFFFFF</color>
    <color name="track_on_color">#F58431</color>
    <color name="track_off_color">#B6BFC9</color>

    <!-- Custom home connect toggle. The off track carries a real border:
         #B6BFC9 on the page was invisible before. -->
    <color name="connect_track_on">#F58431</color>
    <color name="connect_track_off">#B6BFC9</color>
    <color name="connect_track_off_stroke">#68737E</color>
    <color name="connect_thumb_on">#FFFFFF</color>
    <color name="connect_thumb_off">#FFFFFF</color>

    <!-- Connection info rows -->
    <color name="info_row_bg">#FFFFFF</color>
    <color name="info_row_stroke">#D6DDE4</color>

    <color name="profile_background">#E9EDF1</color>
    <color name="profile_card_background">#FFFFFF</color>

    <!-- Segmented control (Cloud / Self-hosted). The thumb is a selected
         surface with an accent border, so the choice is visible without
         relying on the label colour alone. -->
    <color name="nb_segment_track">#E3E8ED</color>
    <color name="nb_segment_track_border">#CDD5DD</color>
    <color name="nb_segment_thumb">#FFE9D6</color>

    <!-- Destructive actions (Remove), mirroring the desktop danger variant -->
    <color name="nb_danger">#B91C1C</color>
</resources>
